{
  "version": 1,
  "caseName": "conversation-session-v4-fork-current-context",
  "spec": "./test/e2e/conversation-session/conversation-session-v4-fork-current-context.test.ts",
  "fixtures": [
    {
      "id": "v4-ctx-fork-title",
      "description": "E2E_V4_CTX_FORK_SEED 首发的 case-local 标题生成响应。",
      "metadata": {
        "kind": "common",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "E2E_V4_CTX_FORK_SEED 首发会触发默认 title sidecar；固定 case-local 标题响应，避免 default replay 回退 legacy provider-basic，并用该首发 marker 隔离跨 case 匹配。"
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_V4_CTX_FORK_SEED"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "v4-ctx-fork-title",
          "inputTokens": 64,
          "outputTokens": 8,
          "text": "{\"title\":\"V4 Current Context Fork E2E\"}"
        }
      }
    },
    {
      "id": "v4-ctx-fork-seed",
      "description": "会话级分叉门禁：父会话首轮固定文本回复，形成待压缩的历史。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "压缩需要一段已完成历史；首轮只需稳定产出可被压缩的 assistant 文本。"
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_V4_CTX_FORK_SEED"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "v4-ctx-fork-seed",
          "inputTokens": 80,
          "outputTokens": 8,
          "text": "V4_CTX_FORK_SEED_OK"
        }
      }
    },
    {
      "id": "v4-ctx-fork-compact",
      "description": "会话级分叉门禁：手动 compact 的 streaming summary 成功响应。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "本用例的核心断言是压缩后 child 复制的是压缩后上下文；summary 文案固定即可，且不含任何 E2E marker。"
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "E2E_V4_CTX_FORK_SEED",
          "CRITICAL: Respond with TEXT ONLY",
          "V4_CTX_FORK_SEED_OK",
          "\"stream\":true"
        ],
        "bodyExcludes": ["Generate a concise title"]
      },
      "response": {
        "statusCode": 200,
        "statusMessage": "OK",
        "delayMs": 300,
        "text": {
          "id": "v4-ctx-fork-compact",
          "inputTokens": 256,
          "outputTokens": 64,
          "text": "<analysis>The manual compaction in this e2e run produced a single completed verification turn without tools.</analysis>\n\n<summary>Conversation so far: one completed turn. The user asked for the initial verification reply and the assistant produced it. No files, tools or follow-up work were required.</summary>"
        }
      }
    }
  ]
}
