{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../scripts/product-identity.mjs"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["ZCODE_APP_ID", "ZCODE_PRODUCT_NAME"]
    },
    "build:desktop-agent": {
      "dependsOn": [
        "@zcode/shared-types#build",
        "@zcode/contracts#build",
        "@zcode/dynamic-workflow#build",
        "@zcode/core#build",
        "@zcode/adapters#build",
        "@zcode/bootstrap#build",
        "@zcode/i18n#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/../../packages/shared/package.json",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/zcode-builtin.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../scripts/product-identity.mjs",
        "$TURBO_ROOT$/../../scripts/load-endpoint-env.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/zcode-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": [
        "ZCODE_ENV",
        "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE",
        "NODE_ENV",
        "ZCODE_APP_ID",
        "ZCODE_PRODUCT_NAME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@zcode/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/zcode-builtin.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../scripts/product-identity.mjs",
        "$TURBO_ROOT$/../../scripts/load-endpoint-env.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/zcode-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": [
        "ZCODE_ENV",
        "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE",
        "NODE_ENV",
        "ZCODE_APP_ID",
        "ZCODE_PRODUCT_NAME"
      ]
    }
  }
}
