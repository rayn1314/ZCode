{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".gitlab/**/*.yml",
    "apps/zcode-cli/tests/gb2312.js",
    "docs/electron/docs/fiddles/**/*.html",
    "packages/zcode-cua/**",
    "packages/desktop/src/renderer/src/plugin-sandbox/genUiTweakRuntime.js",
    "apps/zcode-cli/packages/visualize-plugin/skills/visualize/assets/**",
    "THIRD-PARTY-NOTICES.md",
    "third-party/inventory.json",
    "third-party/upstream/**",
    "third-party/native-search/licenses/**",
    "third-party/runtime/*.txt",
    "docs/knip/docs/LICENSE",
    "docs/knip/docs/licenses/**",
    "docs/electron/**",
    // 该文档的 verified 表由 scripts 追加行：表格行与结束标记必须紧邻才算同一张表。
    // oxfmt 的 Markdown 归一会在标记前插入空行，追加行会落到表外，故整体排除。
    "docs/testing/conversation-session-docker-automation-plan.md"
  ]
}
